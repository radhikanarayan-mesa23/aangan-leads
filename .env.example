# ── Database ────────────────────────────────────────────────────────────────
# A plain Postgres connection string. Works with Neon or Supabase unchanged.
DATABASE_URL=

# ── Voice agent ─────────────────────────────────────────────────────────────
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_PHONE_NUMBER=
VAANI_WEBHOOK_SECRET=
VAANI_TOOL_SECRET=

# ── Calendar ────────────────────────────────────────────────────────────────
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ── Grading ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Alerts ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── CRM ─────────────────────────────────────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=

# ── Recordings (optional; only if the database is Supabase) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=
SESSION_SECRET=change-me-to-32-random-characters

# ── Cost model (₹) ──────────────────────────────────────────────────────────
COST_VAANI_INR_PER_MIN=6
COST_GEMINI_INR_PER_1K_INPUT=0.025
COST_GEMINI_INR_PER_1K_OUTPUT=0.21
