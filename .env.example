# ── Database: Neon ──────────────────────────────────────────────────────────
# Use the POOLED endpoint — the host containing "-pooler". Serverless functions
# open a connection per invocation and will exhaust the direct endpoint.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/aangan?sslmode=require
DATABASE_URL=

# ── Voice agent ─────────────────────────────────────────────────────────────
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_PHONE_NUMBER=
VAANI_WEBHOOK_SECRET=
VAANI_TOOL_SECRET=

# ── Calendar: Cal.com ───────────────────────────────────────────────────────
# Cal.com → Settings → Developer → API keys
CALCOM_API_KEY=
# The NUMERIC id of one shared studio event type: 60 min, 12/1/2/3/4pm IST, Mon–Sat
CALCOM_EVENT_TYPE_ID=
# Signing secret from Cal.com → Settings → Webhooks (BOOKING_CREATED, BOOKING_CANCELLED)
CALCOM_WEBHOOK_SECRET=

# ── Grading ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Alerts ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── CRM ─────────────────────────────────────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=
# Both printed by: npm run hubspot:setup
HUBSPOT_PIPELINE_ID=
# Only needed on free/Starter portals, where we cannot create our own pipeline
# and must map our board columns onto an existing one.
HUBSPOT_STAGE_MAP=

# ── Recordings (dormant) ────────────────────────────────────────────────────
# Unused on Neon: recordings stream through /api/leads/:id/recording, which is
# auth-gated, so the upstream URL never reaches a browser. Leave these empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
CRON_SECRET=
SESSION_SECRET=change-me-to-32-random-characters

# ── Cost model (₹) ──────────────────────────────────────────────────────────
COST_VAANI_INR_PER_MIN=6
COST_GEMINI_INR_PER_1K_INPUT=0.025
COST_GEMINI_INR_PER_1K_OUTPUT=0.21
